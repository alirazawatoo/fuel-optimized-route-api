# Copy to .env and fill in. .env is gitignored; never commit real values.

# Local development only. With DJANGO_DEBUG=false you must set DJANGO_SECRET_KEY.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=fuel_routes
DB_USER=fuel_routes
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Your own key from https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Point this at a self-hosted ORS instance if you run one.
ORS_URL=https://api.openrouteservice.org/v2/directions/driving-car
ORS_TIMEOUT_SECONDS=10

# Requests per client IP to /api/route/; each one spends an ORS call.
ROUTE_RATE_LIMIT=30/minute
